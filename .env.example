# Copy to .env and adjust. Never commit .env.
# Used both for running on the host and by docker-compose (which overrides host/port/models dir).
JAI_ENV=development
JAI_HOST=127.0.0.1
JAI_PORT=8090
JAI_LOG_LEVEL=INFO
JAI_LOG_FORMAT=json
JAI_DOCS_ENABLED=true

# Authentication: "backend" validates the learner's MiraiGo access token against the backend.
JAI_AUTH_MODE=backend
JAI_BACKEND_BASE_URL=http://localhost:8080
# Backend URL from inside the container (docker compose only).
JAI_DOCKER_BACKEND_BASE_URL=http://host.docker.internal:8080
JAI_AUTH_CACHE_TTL_SECONDS=60
# Comma-separated keys for trusted server-to-server callers (header X-API-Key). Empty = off.
JAI_SERVICE_API_KEYS=

# Browser origins allowed to call the API (Expo web dev server, web app).
JAI_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Limits
JAI_MAX_UPLOAD_MB=25
JAI_MAX_AUDIO_SECONDS=120
JAI_MAX_PRONUNCIATION_AUDIO_SECONDS=30
JAI_RATE_LIMIT_PER_MINUTE=120
JAI_INFERENCE_RATE_LIMIT_PER_MINUTE=20
JAI_MAX_CONCURRENT_INFERENCE=1

# Models
JAI_MODELS_DIR=~/.local/share/japanese-ai-platform/models
# Host folder mounted read-only at /models by docker compose.
# JAI_MODELS_HOST_DIR=./models
# JAI_ASR_MODEL=reazonspeech-zipformer-ja   # override the registry's primary
# JAI_MODELS_FILE=/path/to/models.yaml       # custom registry
JAI_WARMUP=true
# JAI_TEMP_DIR=/var/tmp/jai                   # where uploads are staged (keep off RAM-backed /tmp for big files)

# Optional remote fallback (audio leaves the platform when it is used)
# OPENAI_API_KEY=
