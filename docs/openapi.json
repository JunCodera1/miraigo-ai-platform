    "properties": {
     "text": {
      "type": "string",
      "minLength": 1,
      "title": "Text",
      "examples": [
       "私は毎日日本語を勉強しています。"
      ]
     },
     "splitMode": {
      "type": "string",
      "enum": [
       "A",
       "B",
       "C"
      ],
      "title": "Splitmode",
      "description": "A = shortest units, C = longest",
      "default": "C"
     }
    },
    "type": "object",
    "required": [
     "text"
    ],
    "title": "AnalyzeIn"
   },
   "AnalyzeOut": {
    "properties": {
     "text": {
      "type": "string",
      "title": "Text"
     },
     "reading": {
      "type": "string",
      "title": "Reading",
      "description": "Whole sentence in hiragana"
     },
     "romaji": {
      "type": "string",
      "title": "Romaji"
     },
     "tokens": {
      "items": {
       "$ref": "#/components/schemas/TokenOut"
      },
      "type": "array",
      "title": "Tokens"
     }
    },
    "type": "object",
    "required": [
     "text",
     "reading",
     "romaji",
